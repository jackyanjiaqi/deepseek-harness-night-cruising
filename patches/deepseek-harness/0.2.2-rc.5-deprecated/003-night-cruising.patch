diff --git a/apps/web/src/night-cruising.ts b/apps/web/src/night-cruising.ts
new file mode 100644
index 0000000000..6cd3dfff81
--- /dev/null
+++ b/apps/web/src/night-cruising.ts
@@ -0,0 +1,18 @@
+import './night-cruising.css'
+
+const player = document.querySelector<HTMLAudioElement>('#night-track')
+const toggle = document.querySelector<HTMLButtonElement>('#night-play')
+if (player && toggle) {
+  player.src = new URL('./night-cruising.wav', import.meta.url).href
+  player.volume = 0.35
+  const refresh = (): void => {
+    toggle.textContent = player.paused ? '播放音乐' : '暂停音乐'
+    toggle.setAttribute('aria-pressed', String(!player.paused))
+  }
+  toggle.addEventListener('click', () => {
+    if (player.paused) void player.play().catch(() => { toggle.textContent = '播放失败 · 重试' })
+    else player.pause()
+  })
+  player.addEventListener('play', refresh)
+  player.addEventListener('pause', refresh)
+}
