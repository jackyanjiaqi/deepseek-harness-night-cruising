+  box-sizing: border-box;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding-inline: clamp(16px, 4vw, 64px);
+  height: clamp(58px, 11vh, 100px);
+  color: #fff6de;
+  background: linear-gradient(90deg, #101523 0%, #101523ee 19%, #10152350 39%, transparent 66%),
+    url('./night-ride.jpg') center 59% / cover;
+  border-top: 1px solid #756853;
+}
+.night-cruise strong { font-family: 'PingFang SC', sans-serif; font-size: clamp(16px, 2vw, 24px); letter-spacing: .12em; }
+.night-cruise button {
+  color: #fff1d5; background: #18202cef; border: 1px solid #b5a280;
+  border-radius: 20px; font: inherit; font-size: 12px; padding: 7px 14px; cursor: pointer;
+}
+.night-cruise button:focus-visible { outline: 2px solid white; outline-offset: 3px; }
diff --git a/apps/web/src/night-cruising.ts b/apps/web/src/night-cruising.ts
new file mode 100644
index 0000000000..6cd3dfff81
--- /dev/null
+++ b/apps/web/src/night-cruising.ts
@@ -0,0 +1,18 @@
+import './night-cruising.css'
+
+const player = document.querySelector<HTMLAudioElement>('#night-track')
+const toggle = document.querySelector<HTMLButtonElement>('#night-play')
+if (player && toggle) {
+  player.src = new URL('./night-cruising.wav', import.meta.url).href
+  player.volume = 0.35
+  const refresh = (): void => {
+    toggle.textContent = player.paused ? '播放音乐' : '暂停音乐'
+    toggle.setAttribute('aria-pressed', String(!player.paused))
+  }
+  toggle.addEventListener('click', () => {
+    if (player.paused) void player.play().catch(() => { toggle.textContent = '播放失败 · 重试' })
+    else player.pause()
+  })
+  player.addEventListener('play', refresh)
+  player.addEventListener('pause', refresh)
+}
