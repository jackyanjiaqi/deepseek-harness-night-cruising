+  policy.append(releaseLabel, ttlLabel, retentionLabel)
+  owner.append(policy)
+  const save = vaultButton('保存策略', () => {
+    void vaultRequest('POST', 'vault/host/policy', {
+      release: release.value,
+      retentionDays: Number(retention.value),
+    }).then(async () => { await loadVault(); setVaultStatus('策略已保存') }).catch(error => setVaultStatus(error.message, 'error'))
+  })
+  owner.append(save)
+  const clear = vaultButton('清空本机保险柜密文', () => {
+    if (!window.confirm('清空本机已保存的远端保险柜密文？远端账本不会被删除。')) return
+    void vaultRequest('POST', 'vault/clear', {}).then(async () => { await loadVault(); setVaultStatus('已清空本机密文') }).catch(error => setVaultStatus(error.message, 'error'))
+  })
+  owner.append(clear)
+  vaultHost.append(owner)
+}
+
+function tickVaultCountdown(): void {
+  if (vaultHost === null) return
+  let expired = false
+  for (const node of vaultHost.querySelectorAll<HTMLElement>('.nv-countdown')) {
+    const card = node.closest<HTMLElement>('.nv-pending')
+    const expires = Number(card?.dataset.expiresAt ?? 0)
+    if (expires > 0) {
+      node.textContent = remainingText(expires)
+      if (expires <= Date.now()) expired = true
+    }
+  }
+  if (expired) void loadVault()
+}
+
+async function openVaultDir(peerId: string): Promise<void> {
+  try {
+    await vaultRequest('POST', 'vault/host/open', { peer: peerId })
+  } catch (error) {
+    setVaultStatus(error instanceof Error ? error.message : String(error), 'error')
+  }
+}
+
+async function revokeVaultPeer(peerId: string): Promise<void> {
+  if (!window.confirm(`撤销 ${peerId} 对本机全部托管项的访问？对方下一次打开会删除本地密文。`)) return
+  try {
+    await vaultRequest('POST', 'vault/revoke', { peer: peerId })
+    await loadVault()
+    setVaultStatus('已撤销该设备的托管')
+  } catch (error) {
+    setVaultStatus(error instanceof Error ? error.message : String(error), 'error')
+  }
+}
+
+async function deleteVaultContent(peerId: string): Promise<void> {
+  if (!window.confirm(`删除远端设备 ${peerId} 在本机的全部保险柜密文？删除后才能更换目录；远端账本不会自动删除。`)) return
+  try {
+    await vaultRequest('POST', 'vault/host/delete', { peer: peerId })
+    await loadVault()
+    setVaultStatus('已删除该设备在本机的保险柜内容')
+  } catch (error) {
+    setVaultStatus(error instanceof Error ? error.message : String(error), 'error')
+  }
+}
+
+async function approveVaultRoot(peerId: string, root: string): Promise<void> {
+  if (!peerId || !root) { setVaultStatus('需要设备 ID 和目录', 'error'); return }
+  try {
+    await vaultRequest('POST', 'vault/host/root', { peer: peerId, root })
+    await loadVault()
+    setVaultStatus('目录已绑定')
+  } catch (error) {
+    setVaultStatus(error instanceof Error ? error.message : String(error), 'error')
+  }
+}
+
+async function denyVaultPending(id: string): Promise<void> {
+  try {
+    await vaultRequest('POST', 'vault/host/deny', { id })
+    await loadVault()
+    setVaultStatus('已拒绝本次申请')
+  } catch (error) {
+    setVaultStatus(error instanceof Error ? error.message : String(error), 'error')
+  }
+}
+
+function promptVaultRoot(peerId: string, current: string): void {
+  const root = window.prompt(`为远端设备 ${peerId} 选择本机可写目录`, current)
