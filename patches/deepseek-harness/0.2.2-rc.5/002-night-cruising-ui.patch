+.nv-field select, .nv-field input {
+  box-sizing: border-box;
+  width: 100%;
+  padding: 5px 7px;
+  border: 1px solid #ffffff22;
+  border-radius: 7px;
+  background: #070c14;
+  color: #fff;
+  font: inherit;
+  font-size: 11px;
+}
+.nv-empty { color: #ffffff70; font-size: 10.5px; padding: 4px 0; }
