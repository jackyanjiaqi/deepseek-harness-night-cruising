+  if (event.key !== 'Escape') return
+  const timeoutsOpen = panel?.hidden === false
+  const vaultOpen = vaultPanel?.hidden === false
+  if (!timeoutsOpen && !vaultOpen) return
+  event.preventDefault()
+  if (timeoutsOpen) setExpanded(false, false)
+  if (vaultOpen) setVaultExpanded(false, false)
+})
+
+/* Clicking anywhere outside the footer closes the expanded panel, matching the
+ * conventional popover behavior. Clicks inside the footer (including the
+ * toggle and panel controls) stay untouched; Escape still works above. */
+document.addEventListener('pointerdown', (event: PointerEvent) => {
+  const timeoutsOpen = panel?.hidden === false
+  const vaultOpen = vaultPanel?.hidden === false
+  if (!timeoutsOpen && !vaultOpen) return
+  const target = event.target
+  if (!(target instanceof Node)) return
+  if (footer?.contains(target)) return
+  if (timeoutsOpen) setExpanded(false, false)
+  if (vaultOpen) setVaultExpanded(false, false)
+}, true)
+
+/* The chat's running indicator disappearing is the one DOM signal every
+ * conversation view shares (the stop button's localized label is a fallback).
+ * Re-state the timeout as the same minimal white line when output completes;
+ * a rAF gate keeps the observer cheap on streaming updates. */
+const root = document.querySelector<HTMLElement>('#root')
+if (root !== null) {
+  let running = false
+  let scheduled = false
+  const observe = (): void => {
+    scheduled = false
+    const nowRunning = root.querySelector('[data-chat-running]:not([data-holding]), button[aria-label="停止"], button[aria-label="Stop"]') !== null
+    if (running && !nowRunning) flashSummary()
+    running = nowRunning
+  }
+  new MutationObserver(() => {
+    if (scheduled) return
+    scheduled = true
+    requestAnimationFrame(observe)
+  }).observe(root, { childList: true, subtree: true })
+}
