index 0000000000000000000000000000000000000000..6b39177194d57828785e45f14c67078768d0b6ad
--- /dev/null
+++ b/apps/web/src/night-cruising.css
@@ -0,0 +1,507 @@
+/* Night Cruising shell footer: a collapsible timeout settings bar.
+ *
+ * Collapsed it is only the 46–62 px night-ride bar. Expanded it grows upward
+ * inside the body grid (never over the app), so every sidebar, composer and
+ * right panel keeps its own layout; `max-height` reserves at least 260 px for
+ * the application on short windows. The panel scrolls its groups and uses an
+ * auto-fit grid so plugin-added rows keep working as the catalog grows. */
+
+body:has(.night-cruise) {
+  display: grid;
+  grid-template-rows: minmax(0, 1fr) auto;
+  height: 100%;
+  min-height: 100%;
+}
+
+body:has(.night-cruise) > #root {
+  min-height: 0;
+  height: 100%;
+  overflow: hidden;
+}
+
+.night-cruise {
+  --nc-bar-height: clamp(46px, 7vh, 62px);
+  --nc-radius: 14px;
+  --nc-hairline: #ffffff14;
+  --nc-ink: #ffffff;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  color: #fff6de;
+  background: #070b12;
+  border-top: 1px solid #756853;
+  padding-bottom: env(safe-area-inset-bottom, 0px);
+}
+
+/* Reserve room for the conversation and both side panels; the panel scrolls
+ * instead of squeezing the app below ~300 px. */
+.night-cruise[data-expanded='true'] {
+  height: clamp(220px, 52vh, 540px);
+  max-height: calc(100dvh - 300px);
+}
+
+.night-cruise-bar {
+  flex: 0 0 var(--nc-bar-height);
+  min-height: var(--nc-bar-height);
+  box-sizing: border-box;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding-inline: clamp(16px, 4vw, 64px);
+  background:
+    linear-gradient(90deg, #101523 0%, #101523ee 19%, #10152350 39%, transparent 66%),
+    url('./night-ride.jpg') center 59% / cover;
+}
+
+.night-cruise-bar strong {
+  font-family: 'PingFang SC', sans-serif;
+  font-size: clamp(16px, 2vw, 24px);
+  letter-spacing: .12em;
+  white-space: nowrap;
+}
+
+.night-cruise-spacer { flex: 1 1 auto; }
+
+#night-play {
+  flex: 0 0 auto;
+  color: #fff1d5;
+  background: #18202cef;
+  border: 1px solid #b5a280;
+  border-radius: 20px;
+  font: inherit;
+  font-size: 12px;
+  padding: 7px 14px;
+  cursor: pointer;
+}
+
+#night-play:focus-visible,
+.night-timeouts-toggle:focus-visible,
+.night-timeouts button:focus-visible,
+.night-timeouts input:focus-visible {
+  outline: 2px solid white;
+  outline-offset: 2px;
+}
+
+/* The timeout seat is deliberately quiet: bare white text, a small phosphor
+ * dot, and no capsule. It is the only always-visible value in the bar. */
+.night-timeouts-toggle {
+  flex: 0 0 auto;
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  max-width: min(48vw, 360px);
+  padding: 6px 2px;
+  border: 0;
+  background: transparent;
+  color: var(--nc-ink);
+  font: inherit;
+  font-size: 11px;
+  letter-spacing: .02em;
+  font-variant-numeric: tabular-nums;
+  opacity: .72;
+  cursor: pointer;
+  transition: opacity .16s ease;
+}
+
+.night-timeouts-toggle:hover { opacity: 1; }
+
+.night-timeouts-dot {
+  flex: 0 0 auto;
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: #fff;
+  opacity: .55;
+  box-shadow: 0 0 8px #ffffffaa;
+}
+
+#night-timeouts-summary {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* A completed turn re-states the active wait as the same minimal white text. */
+.night-timeouts-flash {
+  animation: night-timeouts-flash 1.6s ease;
+}
+
+@keyframes night-timeouts-flash {
+  0%, 100% { text-shadow: none; }
+  18% { text-shadow: 0 0 12px #ffffffcc; }
+}
+
+/* Expanded panel */
+.night-timeouts {
+  flex: 1 1 auto;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  margin: 10px clamp(12px, 3vw, 40px) 8px;
+  border: 1px solid var(--nc-hairline);
+  border-radius: var(--nc-radius);
+  background: linear-gradient(180deg, #101620f5 0%, #0a0f17fb 100%);
+  box-shadow: 0 -18px 50px #00000055;
+  overflow: hidden;
+}
+
+.night-timeouts[hidden] { display: none; }
+
+.night-timeouts-head {
+  flex: 0 0 auto;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 14px 10px;
+  border-bottom: 1px solid var(--nc-hairline);
+}
+
+.night-timeouts-title {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+
+.night-timeouts-title strong {
+  font-size: 13px;
+  font-weight: 600;
+  letter-spacing: .08em;
+  color: #fff;
+}
+
+.night-timeouts-title span {
+  font-size: 10.5px;
+  color: #ffffff80;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.night-timeouts-filter {
+  margin-left: auto;
+  min-width: 0;
+}
+
+.night-timeouts-filter input {
+  box-sizing: border-box;
+  width: clamp(130px, 18vw, 210px);
+  padding: 5px 8px;
+  border: 1px solid #ffffff1c;
+  border-radius: 8px;
+  background: #0a0f18;
+  color: #fff;
+  font: inherit;
+  font-size: 11px;
+}
+
+.night-timeouts-filter input::placeholder { color: #ffffff55; }
+
+.night-timeouts button {
+  color: #fff1d5;
+  background: #141b26;
+  border: 1px solid #ffffff22;
+  border-radius: 8px;
+  font: inherit;
+  font-size: 11px;
+  padding: 5px 10px;
+  cursor: pointer;
+}
+
+.night-timeouts button:hover { border-color: #ffffff44; }
+
+.night-timeouts-close { flex: 0 0 auto; }
+
+.night-timeouts-groups {
+  flex: 1 1 auto;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  padding: 10px 14px 6px;
+  overflow: auto;
+  overscroll-behavior: contain;
+  scrollbar-gutter: stable;
+}
+
+.night-timeouts-group { min-width: 0; }
+
+.night-timeouts-group h3 {
+  position: sticky;
+  top: -10px;
+  z-index: 1;
+  margin: 0 0 4px;
+  padding: 4px 0;
+  background: #0c121bf2;
+  color: #c9b99a;
+  font-size: 10.5px;
+  font-weight: 600;
+  letter-spacing: .1em;
+}
+
+.night-timeouts-group p {
+  margin: 0 0 6px;
+  color: #ffffff66;
+  font-size: 10px;
+}
+
+.night-timeouts-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
+  gap: 4px 18px;
+}
+
+.night-timeout-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  min-width: 0;
+  padding: 6px 8px;
+  border: 1px solid transparent;
+  border-radius: 8px;
+}
+
+.night-timeout-row:hover {
+  background: #ffffff08;
+  border-color: #ffffff0d;
+}
+
+.night-timeout-row[hidden] { display: none; }
+.night-timeout-row[data-locked] { opacity: .55; }
+
+.night-timeout-copy {
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+  min-width: 0;
+}
+
+.night-timeout-copy strong {
+  color: #fff;
+  font-size: 11.5px;
+  font-weight: 500;
+}
+
+.night-timeout-copy small {
+  color: #ffffff66;
+  font-size: 10px;
+  line-height: 1.35;
+}
+
+/* 0 on a budget row means "no local limit": make it read as a warning. */
+.night-timeout-copy small.night-timeout-zero {
+  color: #ffcc00;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: .01em;
+}
+
+.night-timeout-row[data-unlimited] {
+  border-color: #ffcc0088;
+  background: #ffcc0010;
+}
+
+.night-timeout-row[data-unlimited] input {
+  border-color: #ffcc00cc;
+  color: #ffcc00;
+  box-shadow: 0 0 0 1px #ffcc0033;
+}
+
+.night-timeout-row[data-unlimited] .night-timeout-copy small.night-timeout-zero {
+  padding: 1px 6px;
+  border: 1px solid #ffcc0088;
+  border-radius: 999px;
+  background: #ffcc001f;
+}
+
+.night-timeout-input {
+  flex: 0 0 auto;
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.night-timeout-input input {
+  box-sizing: border-box;
+  width: 76px;
+  padding: 5px 6px;
+  border: 1px solid #ffffff20;
+  border-radius: 7px;
+  background: #0a0f18;
+  color: #fff;
+  font: inherit;
+  font-size: 11.5px;
+  font-variant-numeric: tabular-nums;
+  text-align: right;
+}
+
+.night-timeout-input input:disabled {
+  color: #ffffff88;
+  background: #0a0f1880;
+}
+
+.night-timeout-input span {
+  color: #ffffff66;
+  font-size: 10px;
+}
+
+.night-timeouts-foot {
+  flex: 0 0 auto;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 8px 14px;
+  border-top: 1px solid var(--nc-hairline);
+  background: #080d15;
+}
+
+#night-timeouts-status {
+  min-width: 0;
+  min-height: 1em;
+  color: #9fd6b0;
+  font-size: 10.5px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+#night-timeouts-status[data-tone='error'] { color: #f0a59b; }
+
+.night-timeouts-actions {
+  flex: 0 0 auto;
+  display: flex;
+  gap: 8px;
+  margin-left: auto;
+}
+
+.night-timeouts-save {
+  color: #151a22 !important;
+  background: #e8dcc0 !important;
+  border-color: #e8dcc0 !important;
+}
+
+.night-timeouts-sr {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+@media (max-width: 640px) {
+  .night-cruise[data-expanded='true'] {
+    height: clamp(240px, 62vh, 520px);
+    max-height: calc(100dvh - 260px);
+  }
+
+  .night-timeouts-head { flex-wrap: wrap; }
+  .night-timeouts-filter { order: 3; width: 100%; margin-left: 0; }
+  .night-timeouts-filter input { width: 100%; }
+  .night-timeouts-title span { display: none; }
+  .night-timeouts-toggle { max-width: 42vw; }
+}
+
+@media (max-width: 420px) {
+  .night-cruise-bar {
+    gap: 8px;
+    padding-inline: 12px;
+    overflow: hidden;
+  }
+
+  .night-cruise-bar strong {
+    font-size: 14px;
+    letter-spacing: .06em;
+  }
+
+  #night-play {
+    padding: 6px 9px;
+    font-size: 11px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .night-timeouts-toggle { transition: none; }
+  .night-timeouts-flash { animation: none; }
+}
+
+/* Hosted vault panel: two scopes, explicitly separated. */
+.night-vault-toggle { max-width: min(34vw, 260px); }
+.night-vault-body {
+  flex: 1 1 auto;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 12px 14px 8px;
+  overflow: auto;
+  overscroll-behavior: contain;
+  color: #f6ead3;
+  font-size: 12px;
+}
+.nv-section {
+  border: 1px solid #ffffff14;
+  border-radius: 10px;
+  padding: 10px 12px;
+  background: #0b111af5;
+}
+.nv-section > h3 {
+  margin: 0 0 3px;
+  color: #e8d5b0;
+  font-size: 12px;
+  letter-spacing: .06em;
+}
+.nv-section > p { margin: 0 0 8px; color: #ffffff80; font-size: 10.5px; line-height: 1.55; }
+.nv-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+  padding: 7px 0;
+  border-top: 1px solid #ffffff0d;
+}
+.nv-row:first-of-type { border-top: 0; }
+.nv-peer { flex: 0 0 auto; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #fff; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10.5px; }
+.nv-path { flex: 1 1 auto; min-width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #ffffffa8; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; direction: rtl; text-align: left; }
+.nv-actions { flex: 0 0 auto; display: flex; gap: 6px; }
+.nv-badge { flex: 0 0 auto; border: 1px solid #ffffff24; border-radius: 999px; padding: 3px 7px; color: #d8c39d; font-size: 9.5px; }
+.nv-pending { border-color: #d5a84f66; background: #1b170df5; }
+.nv-pending-head { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
+.nv-countdown { margin-left: auto; color: #ffce7a; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; font-variant-numeric: tabular-nums; }
+.nv-input {
+  box-sizing: border-box;
+  width: 100%;
+  min-width: 180px;
+  padding: 6px 8px;
+  border: 1px solid #ffffff22;
+  border-radius: 7px;
+  background: #070c14;
+  color: #fff;
+  font: inherit;
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 10.5px;
+}
+.nv-actions .nv-input { flex: 1 1 auto; }
+.nv-policy { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: 8px; }
