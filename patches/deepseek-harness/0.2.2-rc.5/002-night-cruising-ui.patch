+}
+
+function setVaultExpanded(open: boolean, focus: boolean): void {
+  if (vaultPanel === null || vaultOpenButton === null || footer === null) return
+  vaultPanel.hidden = !open
+  vaultOpenButton.setAttribute('aria-expanded', String(open))
+  if (open) {
+    if (panel !== null && panel.hidden === false) {
+      panel.hidden = true
+      openButton?.setAttribute('aria-expanded', 'false')
+    }
+    footer.dataset.expanded = 'true'
+    void loadVault()
+    if (vaultTimer === undefined) vaultTimer = setInterval(tickVaultCountdown, 1000)
+    if (focus) vaultCloseButton?.focus()
+  } else {
+    footer.dataset.expanded = panel?.hidden === false ? 'true' : 'false'
+    if (vaultTimer !== undefined) { clearInterval(vaultTimer); vaultTimer = undefined }
+    vaultOpenButton.focus()
+  }
+}
+
+vaultOpenButton?.addEventListener('click', () => { setVaultExpanded(vaultPanel?.hidden !== false, true) })
+vaultCloseButton?.addEventListener('click', () => { setVaultExpanded(false, false) })
+vaultRefreshButton?.addEventListener('click', () => { void loadVault() })
+void loadVault()
+
+openButton?.addEventListener('click', () => {
+  if (vaultPanel !== null && vaultPanel.hidden === false) setVaultExpanded(false, false)
+  setExpanded(panel?.hidden !== false, true)
+})
+closeButton?.addEventListener('click', () => { setExpanded(false, false) })
