index 0000000000000000000000000000000000000000..ff548e1090c8879874b18f498a61215e836cd229
--- /dev/null
+++ b/apps/web/src/night-cruising.ts
@@ -0,0 +1,761 @@
+import './night-cruising.css'
+
+/** One editable timeout row served by `/night-cruising/timeouts`. */
+interface TimeoutEntry {
+  key: string
+  label: string
+  hint?: string
+  defaultMs: number
+  minMs: number
+  maxMs: number
+  /** Display/input unit; absent means milliseconds. */
+  unit?: 'ms' | 'count'
+  /** `0` is a legal value here: it disables the local timer. */
+  allowOff?: boolean
+  locked?: boolean
+}
+
+/** One visual section of the timeout panel. */
+interface TimeoutGroup {
+  id: string
+  label: string
+  hint?: string
+  entries: readonly TimeoutEntry[]
+}
+
+const ROUTE = '/night-cruising/timeouts'
+
+/* ------------------------------------------------------------------ music -- */
+
+const player = document.querySelector<HTMLAudioElement>('#night-track')
+const toggle = document.querySelector<HTMLButtonElement>('#night-play')
+if (player && toggle) {
+  const track = new URL('./night-cruising.wav', import.meta.url)
+  player.volume = 0.35
+  const refresh = (): void => {
+    toggle.textContent = player.paused ? '播放音乐' : '暂停音乐'
+    toggle.setAttribute('aria-pressed', String(!player.paused))
+  }
+  toggle.addEventListener('click', async () => {
+    if (!player.paused) { player.pause(); return }
+    toggle.disabled = true
+    try {
+      // A blob has a known length even when Electron's custom protocol streams the asset.
+      if (!player.src) {
+        const response = await fetch(track)
+        if (!response.ok) throw new Error('夜间巡航音频读取失败')
+        player.src = URL.createObjectURL(await response.blob())
+      }
+      await player.play()
+    } catch {
+      toggle.textContent = '播放失败 · 重试'
+    } finally { toggle.disabled = false }
+  })
+  player.addEventListener('play', refresh)
+  player.addEventListener('pause', refresh)
+}
+
+/* --------------------------------------------------------------- timeouts -- */
+
+const panel = document.querySelector<HTMLElement>('#night-timeouts')
+const openButton = document.querySelector<HTMLButtonElement>('#night-timeouts-toggle')
+const closeButton = document.querySelector<HTMLButtonElement>('#night-timeouts-close')
+const summary = document.querySelector<HTMLElement>('#night-timeouts-summary')
+const groupsHost = document.querySelector<HTMLElement>('#night-timeouts-groups')
+const filterInput = document.querySelector<HTMLInputElement>('#night-timeouts-filter')
+const saveButton = document.querySelector<HTMLButtonElement>('#night-timeouts-save')
+const resetButton = document.querySelector<HTMLButtonElement>('#night-timeouts-reset')
+const status = document.querySelector<HTMLElement>('#night-timeouts-status')
+const footer = document.querySelector<HTMLElement>('.night-cruise')
+const vaultPanel = document.querySelector<HTMLElement>('#night-vault')
+const vaultOpenButton = document.querySelector<HTMLButtonElement>('#night-vault-toggle')
+const vaultCloseButton = document.querySelector<HTMLButtonElement>('#night-vault-close')
+const vaultRefreshButton = document.querySelector<HTMLButtonElement>('#night-vault-refresh')
+const vaultSummary = document.querySelector<HTMLElement>('#night-vault-summary')
+const vaultHost = document.querySelector<HTMLElement>('#night-vault-body')
+const vaultStatus = document.querySelector<HTMLElement>('#night-vault-status')
+
+/** Rows currently rendered, keyed by settings key. */
+const inputs = new Map<string, HTMLInputElement>()
+/** Catalog rows by settings key, for unit-aware form conversion. */
+const entriesByKey = new Map<string, TimeoutEntry>()
+/** Catalog returned by the Host; empty until the first successful load. */
+let groups: readonly TimeoutGroup[] = []
+/** Last persisted milliseconds, keyed by settings key. */
+let values: Readonly<Record<string, number>> = {}
+
+/**
+ * Render one duration as compact Chinese text.
+ * @param ms - Duration in milliseconds; `0` means unlimited.
+ * @returns `不限`, `30 秒`, `10 分`, or `1 小时`.
+ */
+function formatDuration(ms: number | undefined): string {
+  if (ms === undefined || ms === 0) return '不限'
+  if (ms < 60_000) return `${Math.round(ms / 1000)} 秒`
+  if (ms < 3_600_000) return `${Math.round(ms / 60_000)} 分`
+  return `${Math.round(ms / 3_600_000)} 小时`
+}
+
+/**
+ * Convert a stored number to the value shown in an input: milliseconds become
+ * seconds, counts stay whole numbers.
+ * @param entry - catalog row that owns the value.
+ * @param value - stored milliseconds or count.
+ * @returns the input text.
+ */
+function toInput(entry: TimeoutEntry, value: number): string {
+  return entry.unit === 'count' ? String(Math.round(value)) : String(Math.round(value / 1000))
+}
+
+/**
+ * Convert an input's number back to the stored unit.
+ * @param entry - catalog row that owns the value.
+ * @param value - input number in seconds or count.
+ * @returns stored milliseconds or count.
+ */
+function fromInput(entry: TimeoutEntry, value: number): number {
+  return entry.unit === 'count' ? Math.round(value) : Math.round(value * 1000)
+}
+
+/**
+ * Project the primary wait value into the collapsed bar's one-line summary.
+ * The line stays minimal: the first value users tune, plus its cap when it
+ * differs.
+ */
+function refreshSummary(): void {
+  if (summary === null || groups.length === 0) return
+  const primary = formatDuration(values['wait.job.default'])
+  const cap = values['wait.job.max']
+  summary.textContent = cap === undefined || cap === 0
+    ? `超时 ${primary}`
+    : `超时 ${primary} · 上限 ${formatDuration(cap)}`
+}
+
+/**
+ * Set the panel's inline status line.
+ * @param text - Message to show; empty clears it.
+ * @param tone - `ok` for the saved state, `error` for a refused save.
+ */
+function setStatus(text: string, tone: 'ok' | 'error' = 'ok'): void {
+  if (status === null) return
+  status.textContent = text
+  status.dataset.tone = tone
+}
+
+/** Mark the save button actionable while any input differs from the store. */
+function markDirty(): void {
+  if (saveButton === null) return
+  let dirty = false
+  for (const [key, input] of inputs) {
+    if (input.disabled) continue
+    const entry = entriesByKey.get(key)
+    if (entry === undefined) continue
+    if (fromInput(entry, Number(input.value)) !== (values[key] ?? 0)) { dirty = true; break }
+  }
+  saveButton.dataset.dirty = dirty ? 'true' : 'false'
+  saveButton.disabled = !dirty
+}
+
+/**
+ * Flag a row whose value is 0 on a setting that treats 0 as "no local limit".
+ * The row itself turns yellow so "no limit" never looks like a normal value.
+ */
+function refreshZeroWarning(row: HTMLElement, entry: TimeoutEntry, input: HTMLInputElement): void {
+  if (entry.allowOff !== true) return
+  row.toggleAttribute('data-unlimited', Number(input.value) === 0)
+}
+
+/**
+ * Render the catalog exactly as the Host served it. Entries are created as
+ * DOM nodes (never HTML strings), so labels from future plugins stay text.
+ */
+function renderGroups(): void {
+  if (groupsHost === null) return
+  groupsHost.replaceChildren()
+  inputs.clear()
+  entriesByKey.clear()
+  for (const group of groups) {
+    const section = document.createElement('section')
+    section.className = 'night-timeouts-group'
+    const heading = document.createElement('h3')
+    heading.textContent = group.label
+    section.append(heading)
+    if (group.hint !== undefined) {
+      const hint = document.createElement('p')
+      hint.textContent = group.hint
+      section.append(hint)
+    }
+    const grid = document.createElement('div')
+    grid.className = 'night-timeouts-grid'
+    for (const entry of group.entries) {
+      const row = document.createElement('label')
+      row.className = 'night-timeout-row'
+      row.dataset.key = entry.key
+      if (entry.locked) row.dataset.locked = ''
+      const copy = document.createElement('span')
+      copy.className = 'night-timeout-copy'
+      const name = document.createElement('strong')
+      name.textContent = entry.label
+      copy.append(name)
+      if (entry.hint !== undefined) {
+        const hint = document.createElement('small')
+        hint.textContent = entry.hint
+        copy.append(hint)
+      }
+      if (entry.allowOff === true) {
+        const zero = document.createElement('small')
+        zero.className = 'night-timeout-zero'
+        zero.textContent = '⚠ 0 = 不设限制，只能手动取消'
+        zero.title = '填 0 不会让任务更快结束，而是取消时间上限：任务会一直运行，直到你手动停止'
+        copy.append(zero)
+      }
+      const field = document.createElement('span')
+      field.className = 'night-timeout-input'
+      const input = document.createElement('input')
+      input.type = 'number'
+      input.inputMode = 'numeric'
+      input.step = '1'
+      input.min = toInput(entry, entry.minMs)
+      input.max = toInput(entry, entry.maxMs)
+      input.value = toInput(entry, values[entry.key] ?? entry.defaultMs)
+      input.dataset.unit = entry.unit ?? 'ms'
+      input.setAttribute('aria-label', `${entry.label}（${entry.unit === 'count' ? '次' : '秒'}）`)
+      if (entry.locked) {
+        input.disabled = true
+        input.value = '0'
+      }
+      input.addEventListener('input', () => {
+        refreshZeroWarning(row, entry, input)
+        markDirty()
+      })
+      const unit = document.createElement('span')
+      unit.textContent = entry.locked ? '不限' : entry.unit === 'count' ? '次' : '秒'
+      field.append(input, unit)
+      refreshZeroWarning(row, entry, input)
+      row.append(copy, field)
+      grid.append(row)
+      inputs.set(entry.key, input)
+      entriesByKey.set(entry.key, entry)
+    }
+    section.append(grid)
+    groupsHost.append(section)
+  }
+  markDirty()
+  applyFilter()
+}
+
+/**
+ * Hide rows and sections that do not match the filter box.
+ */
+function applyFilter(): void {
+  if (filterInput === null || groupsHost === null) return
+  const needle = filterInput.value.trim().toLocaleLowerCase()
+  for (const section of groupsHost.querySelectorAll<HTMLElement>('.night-timeouts-group')) {
+    let visible = 0
+    for (const row of section.querySelectorAll<HTMLElement>('.night-timeout-row')) {
+      const match = needle === '' || (row.textContent ?? '').toLocaleLowerCase().includes(needle)
+      row.hidden = !match
+      if (match) visible += 1
+    }
+    section.hidden = visible === 0
+    const hint = section.querySelector<HTMLElement>('p')
+    if (hint !== null) hint.hidden = needle !== ''
+  }
+}
+
+/**
+ * Open or close the panel. Expanded state lives on the footer so the body grid
+ * gives the extra height to the footer, never over the application.
+ * @param open - Desired expanded state.
+ * @param focus - Whether to move focus into the filter box.
+ */
+function setExpanded(open: boolean, focus: boolean): void {
+  if (panel === null || openButton === null || footer === null) return
+  if (open && vaultPanel !== null && vaultPanel.hidden === false) setVaultExpanded(false, false)
+  panel.hidden = !open
+  footer.dataset.expanded = open ? 'true' : 'false'
+  openButton.setAttribute('aria-expanded', String(open))
+  if (open && focus) filterInput?.focus()
+  if (!open) openButton.focus()
+}
+
+/** Flash the collapsed summary after a completed save or turn. */
+function flashSummary(): void {
+  if (summary === null) return
+  summary.classList.remove('night-timeouts-flash')
+  // Reading offsetWidth restarts the CSS animation on repeated completions.
+  void summary.offsetWidth
+  summary.classList.add('night-timeouts-flash')
+}
+
+/**
+ * Send every editable row to the Host. The route validates, persists atomically
+ * and republishes the values to the timeout library, so a save applies without
+ * restarting the Host.
+ */
+async function save(): Promise<void> {
+  if (groups.length === 0) return
+  const next: Record<string, number> = { ...values }
+  for (const [key, input] of inputs) {
+    const entry = entriesByKey.get(key)
+    if (entry === undefined || entry.locked) continue
+    const entered = Number(input.value)
+    if (!Number.isFinite(entered) || entered < 0) {
+      setStatus(`${entry.label} 需要一个不小于 0 的${entry.unit === 'count' ? '整数' : '秒数'}`, 'error')
+      input.focus()
+      return
+    }
+    next[key] = fromInput(entry, entered)
+  }
+  if (saveButton !== null) saveButton.disabled = true
+  try {
+    const response = await fetch(ROUTE, {
+      method: 'PUT',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ values: next }),
+    })
+    const payload: unknown = await response.json().catch(() => undefined)
+    if (!response.ok) {
+      const message = typeof payload === 'object' && payload !== null && 'error' in payload
+        ? String((payload as { error: unknown }).error)
+        : `保存失败（HTTP ${String(response.status)}）`
+      setStatus(message, 'error')
+      markDirty()
+      return
+    }
+    const saved = typeof payload === 'object' && payload !== null && 'values' in payload
+      ? (payload as { values?: unknown }).values
+      : undefined
+    if (typeof saved === 'object' && saved !== null && !Array.isArray(saved)) {
+      values = saved as Record<string, number>
+    } else {
+      values = next
+    }
+    setStatus('已保存，立即生效')
+    refreshSummary()
+    markDirty()
+  } catch {
+    setStatus('无法连接夜间巡航设置服务', 'error')
+    markDirty()
+  }
+}
+
+/** Restore every row to its catalog default in the form (a save still confirms). */
+function resetToDefaults(): void {
+  for (const group of groups) {
+    for (const entry of group.entries) {
+      const input = inputs.get(entry.key)
+      if (input === undefined || entry.locked) continue
+      input.value = toInput(entry, entry.defaultMs)
+    }
+  }
+  setStatus('已填入默认值，点击保存生效')
+  markDirty()
+}
+
+/** One pending bootstrap retry; a Host route may register just after the page mounts. */
+let loadRetry: ReturnType<typeof setTimeout> | undefined
+
+/**
+ * Retry the settings bootstrap after the Host has had time to mount its route.
+ * A standalone page that never serves the route gives up after ~20 seconds.
+ * @param attempt - zero-based attempt count.
+ */
+function retryLoad(attempt: number): void {
+  if (loadRetry !== undefined || attempt >= 20) return
+  loadRetry = setTimeout(() => {
+    loadRetry = undefined
+    void load(attempt + 1)
+  }, 1_000)
+}
+
+/**
+ * Load the catalog and persisted values, then reveal the timeout seat.
+ * The route can register a moment after the page mounts, so a failed first
+ * read is retried instead of permanently hiding the seat. A standalone page
+ * that never serves the route stays a music player after the retry window.
+ * @param attempt - zero-based attempt count.
+ */
+async function load(attempt = 0): Promise<void> {
+  try {
+    const response = await fetch(ROUTE, { headers: { accept: 'application/json' } })
+    if (!response.ok) {
+      retryLoad(attempt)
+      return
+    }
+    const payload: unknown = await response.json()
+    if (typeof payload !== 'object' || payload === null || !('groups' in payload) || !('values' in payload)) {
+      retryLoad(attempt)
+      return
+    }
+    const candidate = payload as { groups?: unknown; values?: unknown }
+    if (!Array.isArray(candidate.groups) || typeof candidate.values !== 'object' || candidate.values === null) {
+      retryLoad(attempt)
+      return
+    }
+    groups = candidate.groups as TimeoutGroup[]
+    values = candidate.values as Record<string, number>
+    if (groups.length === 0) {
+      retryLoad(attempt)
+      return
+    }
+    if (loadRetry !== undefined) {
+      clearTimeout(loadRetry)
+      loadRetry = undefined
+    }
+    renderGroups()
+    refreshSummary()
+    if (openButton !== null) openButton.hidden = false
+    document.documentElement.dataset.ncTimeouts = 'ready'
+  } catch {
+    retryLoad(attempt)
+  }
+}
+
+/* --------------------------------------------------------- hosted vault -- */
+
+interface VaultRoot { peerId: string; root: string; approvedAt: number; clearedAt?: number; containers: number; bytes: number }
+interface VaultPending { id: string; peerId: string; reason: string; suggestedRoot?: string; expiresAt: number; createdAt: number; attempts: number }
+interface VaultHostState {
+  roots: VaultRoot[]
+  pending: VaultPending[]
+  ownerPeers: { peerId: string; entries: number; bytes: number; kinds: string[]; lastUsedAt: number }[]
+  policy: { release: 'auto' | 'confirm' | 'deny'; keyTtlMs: number; retentionDays: number }
+}
+
+let vaultState: VaultHostState | null = null
+let vaultTimer: ReturnType<typeof setInterval> | undefined
+
+function vaultEl<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
+  const element = document.createElement(tag)
+  if (className !== undefined) element.className = className
+  if (text !== undefined) element.textContent = text
+  return element
+}
+
+function vaultButton(label: string, action: () => void): HTMLButtonElement {
+  const button = vaultEl('button', undefined, label)
+  button.type = 'button'
+  button.addEventListener('click', action)
+  return button
+}
+
+function setVaultStatus(text: string, tone: 'ok' | 'error' = 'ok'): void {
+  if (vaultStatus === null) return
+  vaultStatus.textContent = text
+  vaultStatus.dataset.tone = tone
+}
+
+async function vaultRequest(method: string, route: string, body?: unknown): Promise<unknown> {
+  const response = await fetch(`/account-mesh/api/${route}`, {
+    method,
+    headers: body === undefined ? { accept: 'application/json' } : { accept: 'application/json', 'content-type': 'application/json' },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  })
+  const text = await response.text()
+  let parsed: unknown = text
+  try { parsed = JSON.parse(text) } catch { /* keep text */ }
+  if (!response.ok) {
+    const message = typeof parsed === 'object' && parsed !== null && 'error' in parsed ? String((parsed as { error?: unknown }).error) : `HTTP ${String(response.status)}`
+    throw new Error(message)
+  }
+  return parsed
+}
+
+function remainingText(expiresAt: number): string {
+  const seconds = Math.max(0, Math.ceil((expiresAt - Date.now()) / 1000))
+  return seconds > 0 ? `剩余 ${String(seconds)} 秒` : '已到期，自动拒绝'
+}
+
+async function loadVault(): Promise<void> {
+  if (vaultHost === null) return
+  try {
+    const payload = await vaultRequest('GET', 'vault/host')
+    const vault = (payload as { vault?: VaultHostState }).vault
+    if (!vault || !Array.isArray(vault.roots) || !Array.isArray(vault.pending)) {
+      vaultOpenButton?.setAttribute('hidden', '')
