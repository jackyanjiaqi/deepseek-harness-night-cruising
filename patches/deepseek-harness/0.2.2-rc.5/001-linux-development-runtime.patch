# Reviewed against dsh-v0.2.2-rc.5 (9c2670d3bc); carried from 0.2.1-rc.2 unchanged.
# Linux x64 source desktop: development target, primary runtime payload and smoke check.
# Behavior on win32/darwin is unchanged (helpers fall back to the upstream paths).
diff --git a/apps/desktop/scripts/dev.ts b/apps/desktop/scripts/dev.ts
--- a/apps/desktop/scripts/dev.ts
+++ b/apps/desktop/scripts/dev.ts
@@ -11,11 +11,35 @@
 import { prepareDevelopmentProject } from './development-project.ts'
 import { prepareDevelopmentApp } from './development-app.ts'
 import { preparePrimaryRuntime } from './prepare-primary-runtime.ts'
+import { preparePrimaryRuntime as preparePayload, smokePrimaryRuntime } from '../../../scripts/primary-runtime/prepare.ts'
 
 const APP_ROOT = resolve(import.meta.dirname, '..')
 const REPOSITORY_ROOT = resolve(APP_ROOT, '..', '..')
 const BUILD_ROOT = join(APP_ROOT, '.desktop-build')
 const DEVELOPMENT_ROOT = join(BUILD_ROOT, 'development')
+
+function developmentTarget(): ReturnType<typeof resolveDesktopBuildTarget> | 'linux-x64' {
+  if (process.platform !== 'linux') return resolveDesktopBuildTarget()
+  if (process.arch !== 'x64') throw new Error(`desktop development: unsupported Linux architecture ${process.arch}`)
+  return 'linux-x64'
+}
+
+function primaryRuntimeDirectory(): string {
+  return process.platform === 'linux'
+    ? join(BUILD_ROOT, 'targets', developmentTarget(), 'runtime', 'primary-runtime')
+    : developmentRuntimeDirectory()
+}
+
+async function prepareDevelopmentRuntime(version: string): Promise<void> {
+  if (process.platform !== 'linux') {
+    await preparePrimaryRuntime()
+    return
+  }
+  const root = primaryRuntimeDirectory()
+  await preparePayload({ target: 'linux-x64', output: join(root, '..'),
+    cache: join(BUILD_ROOT, 'downloads'), version })
+  smokePrimaryRuntime(root)
+}
 
 interface PackageManifest {
   readonly version?: string
