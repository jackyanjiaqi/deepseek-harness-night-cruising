+/** Write one Session's preferred View without a mounted Conversation shell. */
+export function persistConversationViewPreference(sessionId: SessionId, view: string): void {
+  if (typeof localStorage === 'undefined') return
+  try {
+    const key = `${CONVERSATION_STORE_KEY}.${sessionId}`
+    const raw = localStorage.getItem(key)
+    const parsed: unknown = raw === null ? {} : JSON.parse(raw)
+    // The engine replaces the whole state on rehydration instead of merging
+    // over init(); keep the full Conversation shape so a preference written
+    // before the store materializes never drops the draft or view request.
+    const state: Record<string, unknown> = {
+      draft: '',
+      view: null,
+      viewRequest: null,
+      ...(typeof parsed === 'object' && parsed !== null ? parsed as Record<string, unknown> : {}),
+    }
+    state.view = view
+    localStorage.setItem(key, JSON.stringify(state))
+  } catch (_error: unknown) {
+    // Unavailable storage only disables the preference; the live shell path
+    // remains authoritative.
+  }
+}
