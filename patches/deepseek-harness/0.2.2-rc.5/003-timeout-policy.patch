+/**
+ * Timeout registry: the single source of truth for capability budgets.
+ *
+ * Three modes keep the duration of work and the duration of a wait apart:
+ *
+ * - `budget` — how long an operation may run. Expiry terminates the work and
+ *   may be disabled with `0` (only the caller can cancel it then).
+ * - `wait` — how long a caller blocks on work that keeps running. Expiry only
+ *   returns the current state, so a `wait` budget must stay finite: it is the
+ *   valve that keeps an agent turn from freezing on a stuck command.
+ * - `off` — policy: the capability never arms a local timer.
+ *
+ * Every call site passes its capability `code`; no call site hardcodes a
+ * duration. The Night Cruising settings bar is generated from this registry,
+ * so defaults cannot drift between the two.
+ * @module @deepseek-ai/dsh-timeout/registry
+ */
+
+/** Largest delay Node schedules without clamping it to one millisecond. */
+export const MAX_TIMER_DELAY_MS = 2_147_483_647
+
+/** See the module comment: what expiry means for one capability. */
+export type TimeoutMode = 'budget' | 'wait' | 'off'
+
+/** One capability's timeout policy. */
+export interface TimeoutRule {
+  /** Capability code passed to `deadline()` / `waitWindow()`. */
+  code: string
+  /** Settings key shown by the bottom bar; absent for `off` rules. */
+  key?: string
+  /** Footer group id. */
+  group: 'shell' | 'tools' | 'wait' | 'network' | 'services' | 'policy'
+  /** Footer row label. */
+  label: string
+  /** Footer row hint. */
+  hint: string
+  /** Expiry semantics. */
+  mode: TimeoutMode
+  /** Upstream module default; the only place a duration is written down. */
+  defaultMs: number
+  /** Lowest accepted settings value. */
+  minMs: number
+  /** Highest accepted settings value. */
+  maxMs: number
+  /** Whether `0` (no local timer) is a legal settings value; `budget` only. */
+  allowOff?: boolean
+}
+
+/**
+ * Every timeout capability in the product, in footer display order.
+ *
+ * A code that is absent here is not silently disabled: `resolveTimeout()`
+ * falls back to the caller's own budget and warns once.
+ */
+export const TIMEOUT_RULES: readonly TimeoutRule[] = [
+  // Shell execution budgets: `0` means "never kill, only the user may".
+  {
+    code: 'BASH_TIMEOUT', key: 'tool.bash', group: 'shell', mode: 'budget',
+    label: '命令执行', hint: '单条 Shell 命令的运行上限；0 表示只受用户取消。',
+    defaultMs: 120_000, minMs: 0, maxMs: MAX_TIMER_DELAY_MS, allowOff: true,
+  },
+  {
+    code: 'PERSISTENT_BASH_TIMEOUT', key: 'tool.persistentBash', group: 'shell', mode: 'budget',
+    label: '持久终端命令', hint: '持久 Bash/Pwsh 会话的单条命令上限；0 表示只受用户取消。',
+    defaultMs: 300_000, minMs: 0, maxMs: MAX_TIMER_DELAY_MS, allowOff: true,
+  },
+  // The foreground wait is the valve: a stuck command must still return.
+  {
+    code: 'BASH_FOREGROUND_WAIT', key: 'wait.foreground', group: 'wait', mode: 'wait',
+    label: '前台等待', hint: '工具调用等多久后把命令转为后台作业并回到模型；此项不可为 0。',
+    defaultMs: 120_000, minMs: 1_000, maxMs: MAX_TIMER_DELAY_MS,
+  },
+  {
+    code: 'TASK_WAIT_TIMEOUT', key: 'wait.job.default', group: 'wait', mode: 'wait',
+    label: '作业等待', hint: 'job_output 未指定 timeout_ms 时的等待时长。',
+    defaultMs: 30_000, minMs: 1_000, maxMs: 600_000,
+  },
+  {
+    code: 'session/wait-timeout', key: 'wait.session.default', group: 'wait', mode: 'wait',
+    label: '会话等待', hint: '远端会话状态等待的默认时长。',
+    defaultMs: 30_000, minMs: 1_000, maxMs: 600_000,
+  },
+  {
+    code: 'AGENT_WAIT', key: 'wait.agent.default', group: 'wait', mode: 'wait',
+    label: '子智能体等待', hint: 'wait_agent 未指定 timeout_ms 时的等待时长。',
+    defaultMs: 30_000, minMs: 10_000, maxMs: 3_600_000,
+  },
+  // Tool and network budgets.
+  {
