diff --git a/scripts/check-timeouts.mjs b/scripts/check-timeouts.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..10292c88ca9df48fa7f8b66e880e68d7a322a61c
--- /dev/null
+++ b/scripts/check-timeouts.mjs
@@ -0,0 +1,75 @@
+#!/usr/bin/env node
+/**
+ * Timeout policy gate.
+ *
+ * Three rules keep the registry authoritative:
+ * 1. every `deadline()` / `waitWindow()` call names a registered capability code;
+ * 2. no wait call site may pass the timer ceiling (`MAX_TIMER_DELAY_MS` / 2147483647)
+ *    — that is the "wait forever" hack that freezes an agent turn;
+ * 3. every registry `wait` rule has a footer row, so the bar can never lose it.
+ *
+ * Usage: node scripts/check-timeouts.mjs
+ */
+import { readdirSync, readFileSync, statSync } from 'node:fs'
+import { join, relative } from 'node:path'
+
+const ROOT = new URL('..', import.meta.url).pathname.replace(/\/$/, '')
+const REGISTRY = join(ROOT, 'packages/util/timeout/src/registry.ts')
+const CATALOG = join(ROOT, 'packages/bundle/web-app/src/night-timeouts.ts')
+
+/** @returns {string[]} */
+function walk(dir, out = []) {
+  for (const name of readdirSync(dir)) {
+    if (name === 'node_modules' || name === 'lib' || name === 'tests') continue
+    const full = join(dir, name)
+    const stat = statSync(full)
+    if (stat.isDirectory()) walk(full, out)
+    else if (name.endsWith('.ts')) out.push(full)
+  }
+  return out
+}
+
+const registrySource = readFileSync(REGISTRY, 'utf8')
+const codes = new Set([...registrySource.matchAll(/code: '([^']+)'/g)].map(match => match[1]))
+const waitKeys = new Set()
+for (const block of registrySource.matchAll(/\{[^{}]*code: '([^']+)'[^{}]*\}/g)) {
+  if (!/mode: 'wait'/.test(block[0])) continue
+  const key = block[0].match(/key: '([^']+)'/)
+  if (key) waitKeys.add(key[1])
+}
+
+const catalogSource = readFileSync(CATALOG, 'utf8')
+const catalogKeys = new Set([...catalogSource.matchAll(/key: '([^']+)'/g)].map(match => match[1]))
+
+const problems = []
+const roots = ['packages', 'apps'].map(dir => join(ROOT, dir))
+for (const root of roots) {
+  for (const group of readdirSync(root)) {
+    const src = join(root, group, 'src')
+    let stat
+    try { stat = statSync(src) } catch { continue }
+    if (!stat.isDirectory()) continue
+    for (const file of walk(src)) {
+      const text = readFileSync(file, 'utf8')
+      const where = relative(ROOT, file)
+
+      for (const match of text.matchAll(/(?:deadline|waitWindow)\(\s*[^,]+,\s*(?:[^,']*,\s*)?'([A-Za-z0-9_/-]+)'/g)) {
+        if (!codes.has(match[1])) problems.push(`${where}: unregistered timeout code "${match[1]}"`)
+      }
+      if (/wait(?:Deadline|Window)\([^)]*(?:MAX_TIMER_DELAY_MS|2_147_483_647)/.test(text)) {
+        problems.push(`${where}: wait call site uses the timer ceiling (unbounded wait)`)
+      }
+    }
+  }
+}
+
+for (const key of waitKeys) {
+  if (!catalogKeys.has(key)) problems.push(`night-timeouts: wait rule "${key}" has no footer row`)
+}
+
+if (problems.length > 0) {
+  console.error('timeout policy violations:')
+  for (const problem of problems) console.error('  - ' + problem)
+  process.exit(1)
+}
+console.log(`timeout policy ok: ${codes.size} codes, ${waitKeys.size} bounded waits`)
