+  const rule = RULES_BY_KEY.get(key)
+  if (rule === undefined) return undefined
+  if (!Number.isFinite(value) || !Number.isInteger(value)) return `${rule.label} 必须是整数毫秒`
+  if (rule.mode === 'wait' && value <= 0) return `${rule.label} 不能为 0：等待必须有上限`
+  if (!rule.allowOff && value < rule.minMs) return `${rule.label} 不能小于 ${rule.minMs} 毫秒`
+  if (value > rule.maxMs) return `${rule.label} 不能大于 ${rule.maxMs} 毫秒`
+  return undefined
+}
