@@ -0,0 +1,71 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import {
+  configureTimeouts,
+  deadline,
+  resolveTimeout,
+  timeoutRule,
+  waitWindow,
+} from '@deepseek-ai/dsh-timeout'
+
+afterEach(() => {
+  configureTimeouts({})
+  vi.useRealTimers()
+})
+
+describe('timeout registry', () => {
+  it('registers every runtime code with a footer key', () => {
+    for (const code of ['BASH_TIMEOUT', 'TASK_WAIT_TIMEOUT', 'BASH_FOREGROUND_WAIT', 'WEB_FETCH_TIMEOUT', 'MCP_CALL', 'session/wait-timeout']) {
+      const rule = timeoutRule(code)
+      expect(rule, code).toBeDefined()
+      expect(rule?.key, code).toBeTruthy()
+    }
+  })
+
+  it('uses the registry default when the key is unconfigured', () => {
+    expect(resolveTimeout('BASH_TIMEOUT')).toEqual({ ms: 120_000, mode: 'budget' })
+    expect(resolveTimeout('BASH_FOREGROUND_WAIT')).toEqual({ ms: 120_000, mode: 'wait' })
+  })
+
+  it('lets a caller hint only tighten the configured budget', () => {
+    configureTimeouts({ 'tool.bash': 300_000 })
+    expect(resolveTimeout('BASH_TIMEOUT', 60_000).ms).toBe(60_000)
+    expect(resolveTimeout('BASH_TIMEOUT', 900_000).ms).toBe(300_000)
+  })
+
+  it('treats a configured zero as "no local timer" for a budget', () => {
+    configureTimeouts({ 'tool.bash': 0 })
+    expect(resolveTimeout('BASH_TIMEOUT', 60_000).ms).toBe(0)
+  })
+
+  it('refuses a zero wait budget', () => {
+    configureTimeouts({ 'wait.foreground': 0 })
+    expect(() => resolveTimeout('BASH_FOREGROUND_WAIT')).toThrow(/finite/)
+  })
+
+  it('falls back to the caller budget for an unregistered code', () => {
+    const warn = vi.spyOn(console, 'warn').mockImplementation(() => {})
+    expect(resolveTimeout('NOT_A_CODE', 5_000)).toEqual({ ms: 5_000, mode: 'budget' })
+    expect(warn).toHaveBeenCalledTimes(1)
+    warn.mockRestore()
+  })
+
+  it('arms a budget deadline and reports its code', async () => {
+    vi.useFakeTimers()
+    configureTimeouts({ 'tool.bash': 1_000 })
+    using d = deadline(undefined, 1_000, 'BASH_TIMEOUT')
+    vi.advanceTimersByTime(1_000)
+    expect(d.signal.aborted).toBe(true)
+  })
+
+  it('ends a foreground wait at its budget', async () => {
+    vi.useFakeTimers()
+    configureTimeouts({ 'wait.foreground': 2_000 })
+    using d = waitWindow(undefined, 'BASH_FOREGROUND_WAIT')
+    vi.advanceTimersByTime(2_000)
+    expect(d.signal.aborted).toBe(true)
+  })
+
+  it('never arms a wait from an unregistered code', () => {
+    expect(() => waitWindow(undefined, 'NOT_A_CODE')).toThrow(/not a wait budget/)
+  })
+})
