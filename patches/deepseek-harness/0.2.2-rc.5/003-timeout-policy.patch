+    label: 'LSP 关闭', hint: '语言服务关闭的收尾预算。',
+    defaultMs: 10_000, minMs: 1_000, maxMs: 600_000,
+  },
+  {
+    code: 'LSP_CANCEL_GRACE', key: 'lsp.grace', group: 'services', mode: 'budget',
+    label: 'LSP 取消宽限', hint: '语言服务取消请求的宽限时间。',
+    defaultMs: 5_000, minMs: 1_000, maxMs: 600_000,
+  },
