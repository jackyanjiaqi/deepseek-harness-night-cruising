+    label: '工具调用', hint: '工具声明执行预算的通用上限；0 表示不额外封顶。',
+    defaultMs: 0, minMs: 0, maxMs: MAX_TIMER_DELAY_MS, allowOff: true,
+  },
+  {
+    code: 'WORKTREE_TIMEOUT', key: 'tool.worktree', group: 'tools', mode: 'budget',
+    label: '工作树操作', hint: '创建、清理工作树的上限；0 表示只受用户取消。',
+    defaultMs: 120_000, minMs: 0, maxMs: MAX_TIMER_DELAY_MS, allowOff: true,
+  },
+  {
+    code: 'WEB_FETCH_TIMEOUT', key: 'web.fetch', group: 'network', mode: 'budget',
+    label: '网页抓取', hint: '网页抓取请求的上限；0 表示只受用户取消。',
