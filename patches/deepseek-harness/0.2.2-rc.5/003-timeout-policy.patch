+
+/** Lookup by capability code. */
+const RULES_BY_CODE: ReadonlyMap<string, TimeoutRule> = new Map(TIMEOUT_RULES.map(rule => [rule.code, rule]))
+
+/** Lookup by settings key. */
+const RULES_BY_KEY: ReadonlyMap<string, TimeoutRule> = new Map(
+  TIMEOUT_RULES.flatMap(rule => rule.key === undefined ? [] : [[rule.key, rule] as const]),
+)
+
+/** @param code Capability code. @returns Its rule, or `undefined` when unregistered. */
+export function timeoutRule(code: string): TimeoutRule | undefined {
+  return RULES_BY_CODE.get(code)
+}
+
+/** @param key Settings key. @returns The rule that owns it, or `undefined`. */
+export function timeoutRuleByKey(key: string): TimeoutRule | undefined {
+  return RULES_BY_KEY.get(key)
+}
+
+/** Settings store: every published value, keyed by settings key. */
+let values: Readonly<Record<string, number>> = Object.freeze({})
+
+/** Codes already warned about, so an unregistered code logs once. */
+const warned = new Set<string>()
+
+/**
+ * Publish the complete settings map. Values arrive already validated by the
+ * settings surface; this function only takes a defensive copy.
+ * @param next Settings key to number.
+ */
+export function publishSettings(next: Readonly<Record<string, number>>): void {
+  const copy: Record<string, number> = {}
+  for (const [key, value] of Object.entries(next)) {
+    if (Number.isFinite(value) && value >= 0) copy[key] = value
+  }
+  values = Object.freeze(copy)
+}
+
+/**
+ * Read one configured number.
+ * @param key Settings key.
+ * @param fallback Value used when the key is absent.
+ * @returns The configured value, or `fallback`.
+ */
+export function settingNumber(key: string, fallback: number): number {
+  const value = values[key]
+  return value === undefined ? fallback : value
+}
+
+/** @param code Capability code. @returns Whether its rule may be disabled with 0. */
+export function timeoutAllowsOff(code: string): boolean {
+  return RULES_BY_CODE.get(code)?.allowOff === true
+}
+
+/** Effective budget for one capability. */
+export interface ResolvedTimeout {
+  /** Milliseconds to arm; `0` means arm no local timer. */
+  ms: number
+  /** Expiry semantics that produced {@link resolved.ms}. */
+  mode: TimeoutMode
+}
+
+/**
+ * Resolve one capability's effective budget.
+ *
+ * Invariants:
+ * - a caller hint may only tighten the configured budget, never widen it;
+ * - an unconfigured key falls back to the rule default (never to "disabled");
+ * - a `wait` budget is always finite (`minMs`…`maxMs`), because it is the only
+ *   thing that ends a blocked agent turn;
+ * - an unregistered code keeps the caller's budget and warns once.
+ *
+ * @param code Capability code.
+ * @param requested Caller's own budget; `undefined` or non-positive means none.
+ * @returns The effective budget and its mode.
+ */
+export function resolveTimeout(code: string, requested?: number): ResolvedTimeout {
+  const rule = RULES_BY_CODE.get(code)
+  const hint = requested !== undefined && Number.isFinite(requested) && requested > 0 ? requested : undefined
+
+  if (rule === undefined) {
+    if (!warned.has(code)) {
+      warned.add(code)
+      console.warn(`[dsh-timeout] unregistered timeout code "${code}"; using the caller's budget`)
+    }
+    return { ms: hint ?? 0, mode: 'budget' }
+  }
+  if (rule.mode === 'off') return { ms: 0, mode: 'off' }
+
+  const configured = values[rule.key ?? ''] ?? rule.defaultMs
+
+  if (rule.mode === 'wait') {
+    const chosen = hint === undefined ? configured : Math.min(hint, configured)
+    if (!(chosen > 0)) {
+      throw new Error(`wait timeout "${rule.key}" must stay finite; configure a positive value`)
+    }
+    return { ms: Math.max(rule.minMs, Math.min(chosen, rule.maxMs)), mode: 'wait' }
+  }
