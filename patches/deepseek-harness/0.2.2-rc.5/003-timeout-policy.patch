+  },
+  {
+    code: 'MCP_OPERATION', key: 'mcp.operation', group: 'network', mode: 'budget',
+    label: 'MCP 启停/探测', hint: 'MCP 启动、探测、关闭与清理的上限；0 表示只受用户取消。',
