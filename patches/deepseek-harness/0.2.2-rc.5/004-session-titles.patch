+ */
+export function assistantStreamTokenSpan(stream: readonly AssistantStreamRecord[]): { first: number; last: number } | undefined {
+  let first: number | undefined
+  let last: number | undefined
+  for (const { time, chunk } of expandAssistantStream(stream)) {
+    if (!isTokenDelta(chunk)) continue
+    if (first === undefined) first = time
+    last = time
+  }
+  return first === undefined || last === undefined ? undefined : { first, last }
